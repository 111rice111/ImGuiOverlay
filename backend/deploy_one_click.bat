<#
 :BAT_START
 @echo off
 chcp 65001 >nul 2>nul
 title ImGuiOverlay v3.0 - Deploy
 echo.
 echo   ================================================
 echo    ImGuiOverlay Card System v3.0 - One Click
 echo   ================================================
 echo.
 net session >nul 2>&1
 if %errorLevel% NEQ 0 (
     echo [*] Requesting admin...
     powershell -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
     exit /b )
 echo [OK] Admin rights
 if not exist "C:\overlay" mkdir "C:\overlay"
 powershell -NoProfile -ExecutionPolicy Bypass -File "%~f0" -DeployMode
 cd /d C:\overlay
 python server_v3.py --port 8080 --host 0.0.0.0
 pause
 exit /b
#>

# PowerShell section runs below only when called with -DeployMode
param([switch]$DeployMode)
if (-not $DeployMode) { return }

Write-Host "[*] Extracting server_v3.py..."

$self = $PSCommandPath
$raw = [IO.File]::ReadAllBytes($self)
$marker = [Text.Encoding]::ASCII.GetBytes("__B64__`r`n")
$mLen = $marker.Length
$found = $false
for ($i = 0; $i -le $raw.Length - $mLen; $i++) {
    $match = $true
    for ($j = 0; $j -lt $mLen; $j++) {
        if ($raw[$i + $j] -ne $marker[$j]) { $match = $false; break }
    }
    if ($match) {
        $b64Bytes = $raw[($i + $mLen)..($raw.Length - 1)]
        $found = $true; break
    }
}
if (-not $found) { Write-Host "ERROR: __B64__ marker not found"; return }

$b64Str = [Text.Encoding]::ASCII.GetString($b64Bytes).Trim()
try {
    $decoded = [Convert]::FromBase64String($b64Str)
    [IO.File]::WriteAllBytes('C:\overlay\server_v3.py', $decoded)
    Write-Host "[OK] Extracted $($decoded.Length) bytes"
} catch {
    Write-Host "[FAIL] $_"
}

__B64__

